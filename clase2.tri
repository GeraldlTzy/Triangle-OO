let
  type punto ~ class inherits Object
    var x : Integer;
    var y : Integer;
    const pi ~ 3
  end;
  var unPunto : punto;
  var otroPunto : punto
in begin
  unPunto.x := 2;
  otroPunto.y := 5;
  putint(unPunto.x);
  putint(otroPunto.x);
  putint(unPunto.pi);
  putint(otroPunto.pi)
end
