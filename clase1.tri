let
  type punto ~ class inherits Object
    var x : Integer;
    var y : Integer;
    func inicio(n : Integer) : Integer ~ n + 1
  end;
  var unPunto : punto;
  var otroPunto : punto
in begin
  unPunto.x := 2;
  otroPunto.x := 5;
  putint(unPunto.x);
  putint(otroPunto.x);
  putint(unPunto.inicio(3));

end
