let
  var z : Integer;

  type Punto ~ class inherits Object
    var x : Integer;
    var y: Integer;
    var w: Integer;
    var r: Integer;
    const i ~ 5;
    proc setX(self: Punto) ~ self.x := 5;
    proc getX(self: Punto) ~ putint(self.x);
    func getXMasUno(self : Punto) : Integer ~ self.x + 1
  end;

  var unPunto : Punto
  
in begin
  unPunto.y := 3;
  unPunto.x:= 10;
  unPunto.w:=20;
  unPunto.r:=40;
  z := 20;
  putint(unPunto.i);
  putint(unPunto.getXMasUno(unPunto));
  unPunto.setX(unPunto);
  putint(unPunto.x)
end
